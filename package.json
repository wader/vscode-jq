{
	"name": "vscode-jq",
	"displayName": "jq",
	"description": "jq extension for VSCode",
	"author": "Mattias Wadman",
	"license": "MIT",
	"icon": "media/jq.png",
	"version": "0.0.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/wader/vscode-jq"
	},
	"publisher": "dummy",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"coc.nvim",
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.61.0",
		"coc": "^0.0.82"
	},
	"activationEvents": [
		"onLanguage:jq"
	],
	"main": "./client/out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "jq",
				"extensions": [
					".jq"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "jq",
				"scopeName": "source.jq",
				"path": "./syntaxes/jq.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "jq",
				"path": "./snippets/jq.json"
			}
		],
		"configuration": {
			"title": "jq",
			"properties": {
				"jq.serverPath": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "Path to the jq-lsp executable. If empty, the jq-lsp bundled with the extension is used, falling back to jq-lsp in $PATH."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"postinstall": "cd client && npm install && cd .."
	},
	"devDependencies": {
		"@types/node": "^12.12.0",
		"@typescript-eslint/eslint-plugin": "^4.23.0",
		"@typescript-eslint/parser": "^4.23.0",
		"eslint": "^7.26.0",
		"typescript": "^4.3.5"
	}
}
